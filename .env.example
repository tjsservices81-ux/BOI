# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/banking_app

# Session Configuration
SESSION_SECRET=your-secure-session-secret-here

# Email Configuration for OTC Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@yourcompany.com

# Note: For Gmail, use App Passwords instead of your regular password
# Enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords