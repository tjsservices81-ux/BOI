# Team Admin membership registry - per-deployment runtime state
data/teamAccounts.json

# One-time customer-restore marker - must never be committed,
# or a fresh database would skip the restore.
data/.customersRestored

# Development data - kept separate from production, never committed
data/*.dev.json

# Device-usage flags - runtime state per environment
data/deviceFlags.json

# Outstanding invite links - runtime state per environment
data/invites.json

# Everything under data/ is runtime state belonging to one deployment, and
# some of it is customer data. It is never committed: the database is the
# source of truth, and this repository is public.
data/
.env
